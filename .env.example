# PolyBot configuration. Copy to .env (loaded automatically) and edit.
# All values are optional; sane defaults are applied in src/config.js.

# --- server ---
PORT=3000

# Optional PIN that gates the dashboard + API (recommended for any public URL).
# Leave blank to run open (fine on a trusted local network).
PM_DASHBOARD_PIN=

# --- data source ---
# Force the mock market feed even when Polymarket APIs are reachable.
# The feed auto-falls back to mock if the live APIs cannot be reached.
PM_FORCE_MOCK=false

# --- paper trading account ---
PM_STARTING_BALANCE=10000     # virtual USDC
PM_SLIPPAGE_BPS=50            # modelled taker slippage (basis points)
PM_TAKER_FEE_BPS=0            # Polymarket taker fee (currently 0)
PM_TICK_MS=1500              # market refresh / strategy evaluation interval

# --- risk limits ---
PM_ORDER_SIZE_USD=200        # default notional per strategy order
PM_MAX_POSITION_USD=1000     # cap per market+outcome
PM_MAX_EXPOSURE_USD=8000     # cap on total deployed capital

# --- strategies (true/false) ---
PM_STRAT_ARB=true            # cross-outcome arbitrage (YES_ask + NO_ask < 1)
PM_STRAT_MOMENTUM=true       # short-window price momentum
PM_STRAT_COPY=true           # copy-trade tracked wallets

# arbitrage: minimum guaranteed edge before acting
PM_ARB_EDGE=0.02

# momentum: trigger when YES mid moves more than threshold within the window
PM_MOMENTUM_WINDOW_MS=8000
PM_MOMENTUM_THRESHOLD=0.03

# copy-trading: comma-separated proxy wallet addresses to mirror.
# Leave empty to auto-pick the top PnL wallets from the leaderboard.
PM_COPY_WALLETS=
PM_COPY_TOP_N=3
PM_COPY_SCALE=0.02           # fraction of the source trade notional we mirror

# ============================================================================
# LIVE TRADING — REAL MONEY. Off by default. Leave PM_LIVE_TRADING=false to
# stay in simulation. Arming this requires installing the optional deps:
#     npm install @polymarket/clob-client ethers
# and funding/approving USDC on Polygon in the Polymarket app first.
# NEVER commit a real key. Prefer host secret managers over a .env file.
# ============================================================================
PM_LIVE_TRADING=false
PM_PRIVATE_KEY=              # EOA key that controls your Polymarket account
PM_FUNDER_ADDRESS=           # proxy/safe address holding funds (blank = EOA itself)
PM_SIGNATURE_TYPE=0          # 0=EOA, 1=Polymarket proxy, 2=Polymarket Gnosis safe
PM_CLOB_HOST=https://clob.polymarket.com
PM_CHAIN_ID=137              # Polygon
